# Secrets (API keys) — plain text, low value, but keep out of git
.secrets/
# OS junk
Thumbs.db
Desktop.ini
.DS_Store
# Python
__pycache__/
*.pyc
# Playwright MCP (снапшоты/консольные логи браузера)
.playwright-mcp/
# Obsidian
Vault/.obsidian/workspace*
Vault/.obsidian/graph.json
Vault/.obsidian/community-plugins.json
# Плагины Obsidian (код переустанавливается из Community Plugins; community-plugins.json остаётся в git)
Vault/.obsidian/plugins/

# Рабочая папка пользователя: черновики будущих sources (редактируются в Obsidian), вне конвейера
Vault/raw/

# Временные файлы research-сабагентов (создаются при исследовании, НЕ артефакты)
_scripts/_tmp_*
_scripts/ccc_*
_scripts/*_research.py
_scripts/*_final.py
_scripts/*_batch.py
_scripts/*_verify.py
_scripts/*_abs.py
_scripts/*_abs.json
_scripts/*_results.json
_scripts/*_oa_abs.json
raw/evidence/**/subagent_response_retry.txt
